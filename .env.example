# Used by docker-compose.yml as a build arg for the frontend image.
# Set this to the public URL where the backend API will be reachable.
#
# If everything is served from one domain behind the bundled nginx reverse
# proxy (the default docker-compose.yml setup), this should be that same
# domain + "/api" — e.g. https://exam.example.com/api — so the browser
# treats frontend and API calls as same-origin (simpler CORS, and cookies
# just work). For local `docker compose up`, the default below is correct.
VITE_API_URL=http://localhost/api

# Google OAuth Client ID (type: Web application), used by the frontend's
# "Continue with Google" button and One Tap prompt. Must be the exact same
# value as GOOGLE_CLIENT_ID in backend/.env — the backend verifies each
# Google ID token's audience against it.
VITE_GOOGLE_CLIENT_ID=
