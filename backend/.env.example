PORT=5000
NODE_ENV=development

# Timezone that exam date/time pickers are interpreted in (IANA name).
# This makes exam scheduling explicit and independent of whatever OS
# timezone the server process happens to run under (Render/Railway/Docker
# containers default to UTC; your dev laptop may not) — see
# backend/utils/dateTime.js for the full explanation. Defaults to
# Asia/Kolkata if unset.
APP_TIMEZONE=Asia/Kolkata

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/online-exam

# JWT — use a long, random, secret string in real environments
JWT_SECRET=

# Access token (short-lived, returned in the JSON response body)
ACCESS_TOKEN_EXPIRES_IN=15m

# Refresh token (opaque, stored hashed in the Session collection, sent as
# an httpOnly cookie). Two lifetimes: normal login vs "Remember me".
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN_REMEMBER=30d

# Frontend origin (used for CORS — must be an explicit origin, not "*",
# because the refresh-token cookie requires credentials:true)
CLIENT_URL=http://localhost:5173

# Google Sign-In (Continue with Google + One Tap). Create an OAuth 2.0
# Client ID (type: Web application) in Google Cloud Console and add both
# your CLIENT_URL and its production origin under "Authorized JavaScript
# origins". Must match VITE_GOOGLE_CLIENT_ID in frontend/.env exactly —
# the ID token's "audience" is verified against this value.
GOOGLE_CLIENT_ID=

# SMTP (used to send OTP verification codes and password-reset codes).
# Leave unset in development — emails will be printed to the server
# console instead of actually being sent. Required in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ExamSecure AI <no-reply@examsecure.ai>

# AI Question Generation (OpenAI-compatible API)
# Supports OpenAI, Groq, or any OpenAI-compatible provider.
# Set the base URL and API key for your chosen provider.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
